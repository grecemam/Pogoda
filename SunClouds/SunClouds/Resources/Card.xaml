<UserControl x:Class="SunClouds.Resources.Card"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SunClouds.Resources"
             mc:Ignorable="d" 
             d:DesignHeight="170" d:DesignWidth="110" MaxWidth="170">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Background="{DynamicResource Second}" Grid.Row="0">
            <Image Name="Picture" Source="{Binding img, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="5"></Image>
        </Grid>
        <Grid Background="{DynamicResource Focus}" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Name="Time" Text="{Binding time, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="White" FontFamily="#Jura" FontSize="20" TextAlignment="Center"></TextBlock>
            <TextBlock Name="Temp" Text="{Binding temp, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="White" FontFamily="#Jura" FontSize="20" TextAlignment="Center" Grid.Row="1"></TextBlock>
        </Grid>
        <Grid Background="{DynamicResource Second}" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Влаж." Foreground="White" FontFamily="#Jura" FontSize="18" TextAlignment="Center"></TextBlock>
            <TextBlock Name="Humidity" Text="{Binding humidity, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="White" FontFamily="#Jura" FontSize="20" TextAlignment="Center" Grid.Row="1"></TextBlock>
            <TextBlock Text="Ощущ." Foreground="White" FontFamily="#Jura" FontSize="18" TextAlignment="Center" Grid.Column="1"></TextBlock>
            <TextBlock Name="Feels" Text="{Binding feels, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="White" FontFamily="#Jura" FontSize="20" TextAlignment="Center" Grid.Column="1" Grid.Row="1"></TextBlock>
        </Grid>
    </Grid>
</UserControl>
