<UserControl x:Class="SunClouds.Resources.FavCityCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SunClouds.Resources"
             mc:Ignorable="d" 
             d:DesignHeight="88" d:DesignWidth="195">
    <Grid Background="{DynamicResource Focus}">
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock FontFamily="#Jura" Foreground="White" FontSize="20" Text="{Binding CityName}" TextAlignment="Center" Margin="0,6,0,4"></TextBlock>
            <Button Width="20" Height="20" Name="Select" Margin="155,0,20,24" BorderThickness="0" Foreground="White" Content="✚" Background="{DynamicResource Focus}" Click="button1_Click"></Button>
            <Button Width="20" Height="20" Name="Delete" Margin="175,0,0,24" BorderThickness="0" Foreground="White" Content="X" Background="{DynamicResource Focus}" Click="button2_Click"></Button>
        </Grid>
        <Grid Background="{DynamicResource Second}" Grid.Row="1">
            <TextBlock FontFamily="#Jura" Foreground="White" FontSize="20" Text="{Binding Coords}" TextAlignment="Center" Margin="0,6,0,4"></TextBlock>
        </Grid>
    </Grid>
</UserControl>
