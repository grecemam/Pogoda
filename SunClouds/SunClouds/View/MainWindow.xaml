<Window x:Class="SunClouds.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SunClouds"
        mc:Ignorable="d"
        Title="SunClouds" Name="SunCloudsWindow" Height="450" Width="800" MinHeight="170" MinWidth="220" WindowStyle="None" WindowStartupLocation="CenterScreen" Icon="pack://siteoforigin:,,,/Resources/Icon.png" SizeChanged="Window_SizeChanged">
    <Grid Background="{DynamicResource Main}">
        <Label Name="CloseBtn" BorderThickness="0" Content="X" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Buttons}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="#Jura" Height="15" Width="15" Margin="0,12,12,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" MouseEnter="SpecialBtn_MouseEnter" MouseLeave="SpeacialBtn_MouseLeave" MouseDoubleClick="CloseBtn_MouseDoubleClick">
            <Label.Background>
                <SolidColorBrush Opacity="0"></SolidColorBrush>
            </Label.Background>
        </Label>
        <Label Name="HideBtn" BorderThickness="0" Content="-" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource Buttons}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="#Jura" Height="15" Width="15" Margin="0,10,52,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" MouseEnter="SpecialBtn_MouseEnter" MouseLeave="SpeacialBtn_MouseLeave" MouseDoubleClick="HideBtn_MouseDoubleClick">
            <Label.Background>
                <SolidColorBrush Opacity="0"></SolidColorBrush>
            </Label.Background>
        </Label>
        <Label Name="FullSizeBtn" BorderThickness="0" Content="▢" Padding="0" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Buttons}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="#Jura" Height="15" Width="15" Margin="0,12,32,0" HorizontalAlignment="Right" VerticalAlignment="Top" MouseEnter="SpecialBtn_MouseEnter" MouseLeave="SpeacialBtn_MouseLeave" MouseDoubleClick="FullSizeBtn_MouseDoubleClick">
            <Label.Background>
                <SolidColorBrush Opacity="0"></SolidColorBrush>
            </Label.Background>
        </Label>
        <Grid Width="206" Height="158" Margin="0">
            <Grid.Background>
                <SolidColorBrush Color="#F8C5B4" Opacity="0.5"></SolidColorBrush>
            </Grid.Background>
            <Border BorderBrush="#F8C5B4" BorderThickness="0, 0, 0, 2" Opacity="0.25">
                <Border.Effect>
                    <DropShadowEffect Direction="270" ShadowDepth="4" ></DropShadowEffect>
                </Border.Effect>
            </Border>
            <Label Width="206" Height="52" VerticalAlignment="Top" Content="SunClouds" FontSize="20" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="#Jura"/>
            <Rectangle Fill="White" Width="174" Opacity="0.5" Height="1" Margin="15.25, 52, 15.25, 105"/>
            <TextBox Name="CityName" Background="{DynamicResource Second}" Opacity="0.5" TextWrapping="NoWrap" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="White" FontFamily="#Jura" Height="25" Margin="16,67,39,66" BorderThickness="0"></TextBox>
            <Button BorderThickness="0" Background="{DynamicResource Second}" Opacity="0.5" Name="ClearCityName" FontFamily="#Jura" Foreground="White" FontSize="15" Width="23" Height="25" Margin="167,67,16,66" Content="X" Padding="0,2,0,0" Click="ClearCityName_Click"></Button>
            <Button BorderThickness="0" Content="Узнать погоду" FontSize="15" Foreground="White" Background="{DynamicResource Second}" FontFamily="#Jura" Height="25" Width="174" Margin="16,115,16,18" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="Button_Click"></Button>
        </Grid>
    </Grid>
</Window>

